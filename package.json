{
  "name": "sfm-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SFM Studio - a visual Minecraft Super Factory Manager script builder",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
